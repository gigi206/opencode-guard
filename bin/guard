#!/usr/bin/env node
// Command line of the guard plugin (docs/configuration.md, "The guard command"). Node strips the types of the
// TypeScript sources it imports: no build step, no dependency.
import { main } from "../src/cli/main.ts"
import { terminalOf } from "../src/cli/style.ts"
import { systemConfigDirectory } from "../src/index.ts"

const terminal = terminalOf(process.env, process.stdout.isTTY, process.stdout.columns)
// The reader went away (`guard rules | head`): nothing more to print, stop quietly; any other output error is thrown.
for (const stream of [process.stdout, process.stderr])
  stream.on("error", (error) => {
    if (error.code === "EPIPE") process.exit(process.exitCode ?? 0)
    throw error
  })

process.exitCode = await main(process.argv.slice(2), {
  env: process.env,
  cwd: process.cwd(),
  systemDir: systemConfigDirectory(),
  out: (line) => process.stdout.write(`${line}\n`),
  err: (line) => process.stderr.write(`${line}\n`),
  ...(terminal ? { terminal } : {}),
})
